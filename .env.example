# Copy to .env and fill in. Never commit real values.
APP_ENV=development
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me
DATABASE_URL=mysql+pymysql://saferoute:change-me@127.0.0.1:3306/saferoute?charset=utf8mb4
MYSQL_ROOT_PASSWORD=change-me
MYSQL_PASSWORD=change-me
FRONTEND_URL=http://localhost:5173
# Only needed when the frontend is served from a different origin than the API.
CORS_ORIGINS=
TRUST_PROXY=false
RATELIMIT_STORAGE_URI=memory://
# console = log emails to the terminal (development). smtp = send for real.
MAIL_BACKEND=console
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=SafeRoute <no-reply@example.com>
# Optional first admin created by `flask seed` (password 12+ chars).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Nominatim-compatible geocoder. The public server needs a real contact in the User-Agent.
GEOCODER_URL=https://nominatim.openstreetmap.org/search
GEOCODER_USER_AGENT=SafeRoute/0.1 (you@example.com)
