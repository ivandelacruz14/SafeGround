# Frontend variables are public (bundled into the browser). Never put secrets here.
VITE_API_BASE=/api/v1
# Dev default is the public OSM tile server, which forbids heavy/production use.
# For production use a compliant provider or self-hosted tiles (see README).
VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
# Set to 1 when the tiles are already dark; otherwise a CSS filter darkens light tiles.
VITE_TILES_ARE_DARK=0
